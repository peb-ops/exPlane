<Window x:Class="ExPlane.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="exPlane"
        Width="300" Height="520" MinWidth="220" MinHeight="200"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
        FontFamily="Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the whole row is draggable via WindowChrome.CaptionHeight. -->
        <Grid Background="{StaticResource SurfaceBrush}">
            <TextBlock Text="exPlane" Margin="10,0" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ToggleButton x:Name="PinButton" Style="{StaticResource IconToggleStyle}"
                              WindowChrome.IsHitTestVisibleInChrome="True" Click="PinButton_Click">
                    <TextBlock x:Name="PinGlyph" FontFamily="{StaticResource IconFont}" FontSize="13" Text="&#xE718;" />
                </ToggleButton>
                <Button Style="{StaticResource IconButtonStyle}" ToolTip="Hide to tray"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="10" Text="&#xE8BB;" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Module host: rows are built in code (content-sized or filling, per module). -->
        <Grid x:Name="ModuleHost" Grid.Row="1" SizeChanged="ModuleHost_SizeChanged" />
    </Grid>
</Window>
