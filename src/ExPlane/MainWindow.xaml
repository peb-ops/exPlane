<Window x:Class="ExPlane.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="exPlane"
        Width="320" Height="560" MinWidth="240" MinHeight="220"
        WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: the whole row is draggable via WindowChrome.CaptionHeight. -->
        <Grid Background="{StaticResource SurfaceBrush}">
            <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource BorderBrush}" />
            <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="&#xE823;" FontFamily="{StaticResource IconFont}" FontSize="13"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                <TextBlock Text="exPlane" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,2,0">
                <ToggleButton x:Name="PinButton" Style="{StaticResource PinToggleStyle}"
                              WindowChrome.IsHitTestVisibleInChrome="True" Click="PinButton_Click" />
                <Button x:Name="MoreButton" Style="{StaticResource TitleButtonStyle}" Content="&#xE712;" ToolTip="More"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="MoreButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MoreMenu" Opened="MoreMenu_Opened">
                            <MenuItem x:Name="TopmostMenuItem" Header="Always on top" Click="TopmostMenuItem_Click" />
                            <MenuItem x:Name="StartupMenuItem" Header="Start with Windows" Click="StartupMenuItem_Click" />
                            <MenuItem Header="Lock now" Icon="&#xE72E;" Click="LockNowMenuItem_Click" />
                            <MenuItem x:Name="LockAfterMenu" Header="Lock when idle" Icon="&#xE916;">
                                <MenuItem Header="After 30 seconds" Tag="30" Click="LockAfterMenuItem_Click" />
                                <MenuItem Header="After 1 minute" Tag="60" Click="LockAfterMenuItem_Click" />
                                <MenuItem Header="After 2 minutes" Tag="120" Click="LockAfterMenuItem_Click" />
                                <MenuItem Header="After 5 minutes" Tag="300" Click="LockAfterMenuItem_Click" />
                                <MenuItem Header="Never" Tag="0" Click="LockAfterMenuItem_Click" />
                            </MenuItem>
                            <Separator />
                            <MenuItem Header="Hide to tray" Icon="&#xE921;" Click="HideMenuItem_Click" />
                            <Separator />
                            <MenuItem Header="Exit exPlane" Icon="&#xE7E8;" Click="ExitMenuItem_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Style="{StaticResource TitleButtonStyle}" Content="&#xE921;" FontSize="11" ToolTip="Hide to tray"
                        WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <!-- Module host: rows are built in code (content-sized or filling, per module). -->
        <Grid x:Name="ModuleHost" Grid.Row="1" SizeChanged="ModuleHost_SizeChanged" />

        <!-- Idle lock view over the content (the title bar stays usable). Any click returns to the main view. -->
        <Border x:Name="LockLayer" Grid.Row="1" Background="{StaticResource BgBrush}" Visibility="Collapsed" Opacity="0"
                MouseDown="LockLayer_MouseDown" />
    </Grid>
</Window>
