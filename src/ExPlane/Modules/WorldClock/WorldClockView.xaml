<UserControl x:Class="ExPlane.Modules.WorldClock.WorldClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ExPlane.Modules.WorldClock"
             Background="{StaticResource SurfaceBrush}">
    <UserControl.ContextMenu>
        <ContextMenu Opened="ClockMenu_Opened">
            <MenuItem Header="24-hour clock" Tag="24h" Click="Use24Hour_Click" />
        </ContextMenu>
    </UserControl.ContextMenu>
    <DockPanel Margin="12,6,4,0">
        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Margin="0,-2,0,0" Style="{StaticResource IconButtonStyle}"
                Width="30" Height="30" Padding="3" FontSize="12" Content="&#xE710;"
                ToolTip="Add timezone" Click="AddButton_Click" />

        <!-- Local time, then a thin divider, then the other zones. -->
        <local:LocalClockView DockPanel.Dock="Left" DataContext="{Binding Local}" VerticalAlignment="Top" Margin="0,4,10,6" />
        <Border DockPanel.Dock="Left" Width="1" Height="16" VerticalAlignment="Top" Margin="0,5,8,0"
                Background="{StaticResource StrongBorderBrush}" />

        <Grid>
            <TextBlock Text="Add timezones to compare" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                       VerticalAlignment="Top" Margin="0,4,0,10">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- One chip per timezone; wraps onto more lines as needed. -->
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Chip" CornerRadius="12" Padding="8,4" Margin="0,0,6,6"
                                Background="{StaticResource ChipBrush}" ToolTip="{Binding Summary}">
                            <Border.ContextMenu>
                                <ContextMenu Opened="ClockMenu_Opened">
                                    <MenuItem Header="Rename…" Icon="&#xE8AC;" Click="RenameMenu_Click" />
                                    <MenuItem Header="Remove" Icon="&#xE74D;" Foreground="{StaticResource DangerBrush}"
                                              Click="RemoveMenu_Click" />
                                    <Separator />
                                    <MenuItem Header="24-hour clock" Tag="24h" Click="Use24Hour_Click" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <!-- Icon, time and day marker always show in full; only the label trims when space is tight. -->
                            <DockPanel>
                                <TextBlock x:Name="DayIcon" DockPanel.Dock="Left" Text="&#xE706;" FontFamily="{StaticResource IconFont}"
                                           FontSize="11" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="DayMarker" DockPanel.Dock="Right" Text="{Binding DayMarker}" FontSize="11"
                                           Foreground="{StaticResource WarnBrush}" Margin="4,0,0,0" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource NumericTextStyle}"
                                           FontSize="12.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" MaxWidth="96" TextTrimming="CharacterEllipsis" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDaytime}" Value="False">
                                <Setter TargetName="DayIcon" Property="Text" Value="&#xE708;" />
                                <Setter TargetName="DayIcon" Property="Foreground" Value="{StaticResource SubtleBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOtherDay}" Value="True">
                                <Setter TargetName="DayMarker" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding ContextMenu.IsOpen, ElementName=Chip}" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{StaticResource HoverBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </DockPanel>
</UserControl>
