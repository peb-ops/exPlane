<UserControl x:Class="ExPlane.Modules.WorldClock.WorldClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Button DockPanel.Dock="Bottom" Style="{StaticResource IconButtonStyle}"
                Width="Auto" Height="30" HorizontalAlignment="Stretch" Click="AddButton_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE710;"
                           VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="Add timezone" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" Padding="10,6" Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=LostFocus}"
                                             IsReadOnly="{Binding IsLocal, Mode=OneWay}"
                                             Style="{StaticResource InlineEditStyle}"
                                             ToolTip="Click to rename" KeyDown="Label_KeyDown" />
                                    <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11">
                                        <Run Text="{Binding DateText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding OffsetText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="24"
                                           FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0" />

                                <Button x:Name="RemoveButton" Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                                        Width="22" Height="22" Margin="6,0,-4,0" ToolTip="Remove"
                                        Visibility="Hidden" Click="RemoveButton_Click">
                                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="9" Text="&#xE711;" />
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding IsMouseOver, ElementName=Row}" Value="True" />
                                    <Condition Binding="{Binding IsLocal}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
