<Window x:Class="ExPlane.Modules.WorldClock.AddTimezoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExPlane.Controls"
        Title="Add timezone" Width="400" Height="500"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <Window.Resources>
        <Style x:Key="ZoneItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="5" Padding="10,7" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <controls:DialogTitleBar DockPanel.Dock="Top" Text="Add timezone" />

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Height="60" Padding="20,0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Add" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                        Click="AddButton_Click" />
            </StackPanel>
        </Border>

        <DockPanel Margin="20,16,20,16">
            <TextBlock DockPanel.Dock="Top" Text="Search by city, region or UTC offset" FontSize="12"
                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource InputStyle}"
                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />

            <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock Text="Label" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                <TextBox x:Name="LabelBox" Style="{StaticResource InputStyle}" />
            </StackPanel>

            <Border Margin="0,10,0,0" CornerRadius="6" BorderThickness="1" Padding="4"
                    BorderBrush="{StaticResource BorderBrush}" Background="{StaticResource BgBrush}">
                <ListBox x:Name="ZoneList" DisplayMemberPath="DisplayName" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource FgBrush}" ItemContainerStyle="{StaticResource ZoneItemStyle}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="ZoneList_SelectionChanged" MouseDoubleClick="ZoneList_MouseDoubleClick" />
            </Border>
        </DockPanel>
    </DockPanel>
</Window>
