<Window x:Class="ExPlane.Modules.WorldClock.AddTimezoneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add timezone" Width="400" Height="480" MinWidth="300" MinHeight="300"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=SearchBox}">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" Text="Search by city, region or UTC offset"
                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
        <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Style="{StaticResource InputStyle}"
                 TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock Text="Label" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="LabelBox" Style="{StaticResource InputStyle}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Add" IsDefault="True" Style="{StaticResource DialogButtonStyle}" Click="AddButton_Click" />
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <ListBox x:Name="ZoneList" Margin="0,8,0,0" DisplayMemberPath="DisplayName"
                 Background="{StaticResource SurfaceBrush}" Foreground="{StaticResource FgBrush}"
                 BorderBrush="{StaticResource BorderBrush}"
                 SelectionChanged="ZoneList_SelectionChanged" MouseDoubleClick="ZoneList_MouseDoubleClick" />
    </DockPanel>
</Window>
