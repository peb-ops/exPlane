<UserControl x:Class="ExPlane.Modules.WorldClock.LockScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BgBrush}" Cursor="Hand">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Local time, phone-lock-screen style -->
        <StackPanel Margin="0,40,0,24" HorizontalAlignment="Center" DataContext="{Binding Local}">
            <TextBlock Text="{Binding TimeText}" Style="{StaticResource NumericTextStyle}" FontSize="48"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding LongDateText}" FontSize="14" Foreground="{StaticResource MutedBrush}"
                       HorizontalAlignment="Center" Margin="0,2,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="12,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Height="40" Padding="8,0" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                            <DockPanel>
                                <TextBlock x:Name="DayIcon" DockPanel.Dock="Left" Text="&#xE706;" FontFamily="{StaticResource IconFont}"
                                           FontSize="13" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="DayMarker" DockPanel.Dock="Right" Text="{Binding DayMarker}" FontSize="11"
                                           Foreground="{StaticResource WarnBrush}" Margin="5,0,0,0" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Style="{StaticResource NumericTextStyle}"
                                           FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="14" Margin="12,0,0,0" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsDaytime}" Value="False">
                                <Setter TargetName="DayIcon" Property="Text" Value="&#xE708;" />
                                <Setter TargetName="DayIcon" Property="Foreground" Value="{StaticResource SubtleBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOtherDay}" Value="True">
                                <Setter TargetName="DayMarker" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" Text="Click to open" FontSize="11" Foreground="{StaticResource SubtleBrush}"
                   HorizontalAlignment="Center" Margin="0,8,0,14" />
    </Grid>
</UserControl>
