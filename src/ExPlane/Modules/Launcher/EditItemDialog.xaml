<Window x:Class="ExPlane.Modules.Launcher.EditItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add item" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="ToolWindow" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource FgBrush}"
        FontFamily="Segoe UI" FontSize="13"
        FocusManager.FocusedElement="{Binding ElementName=TargetBox}">
    <StackPanel Margin="12">
        <TextBlock Text="Target: file, folder, URL or command" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TargetBox" Style="{StaticResource InputStyle}" TextChanged="TargetBox_TextChanged" />
            <Button Grid.Column="1" Content="File…" Style="{StaticResource DialogButtonStyle}" MinWidth="0" Click="BrowseFile_Click" />
            <Button Grid.Column="2" Content="Folder…" Style="{StaticResource DialogButtonStyle}" MinWidth="0" Click="BrowseFolder_Click" />
        </Grid>

        <TextBlock Text="Arguments (optional)" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4" />
        <TextBox x:Name="ArgumentsBox" Style="{StaticResource InputStyle}" />

        <TextBlock Text="Label" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,4" />
        <TextBox x:Name="LabelBox" Style="{StaticResource InputStyle}" TextChanged="LabelBox_TextChanged" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OkButton" Content="Add" IsDefault="True" Style="{StaticResource DialogButtonStyle}" Click="Ok_Click" />
            <Button Content="Cancel" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
