<Window x:Class="ExPlane.Modules.Launcher.EditItemDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExPlane.Controls"
        Title="Add item" Width="460" SizeToContent="Height"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=TargetBox}">
    <StackPanel>
        <controls:DialogTitleBar x:Name="TitleBar" Text="Add item" />

        <StackPanel Margin="20,18,20,18">
            <!-- Live preview of the tile -->
            <Border CornerRadius="8" Padding="12,10" BorderThickness="1"
                    Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image x:Name="PreviewIcon" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality"
                           VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="14,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="PreviewLabel" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="PreviewKind" FontSize="12" Foreground="{StaticResource SubtleBrush}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                    </StackPanel>
                    <Border x:Name="StatusChip" Grid.Column="2" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" FontSize="11" />
                    </Border>
                </Grid>
            </Border>

            <Label Target="{Binding ElementName=TargetBox}" Padding="0" Margin="0,14,0,6" FontSize="12"
                   Foreground="{StaticResource MutedBrush}" Content="_Target: file, folder, URL or command" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TargetBox" Style="{StaticResource InputStyle}" TextChanged="TargetBox_TextChanged" />
                <Button Grid.Column="1" Content="File…" Style="{StaticResource SecondaryButtonStyle}" MinWidth="0"
                        Margin="6,0,0,0" Click="BrowseFile_Click" />
                <Button Grid.Column="2" Content="Folder…" Style="{StaticResource SecondaryButtonStyle}" MinWidth="0"
                        Margin="6,0,0,0" Click="BrowseFolder_Click" />
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <Label Target="{Binding ElementName=LabelBox}" Padding="0" Margin="0,0,0,6" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Content="_Label" />
                    <TextBox x:Name="LabelBox" Style="{StaticResource InputStyle}" TextChanged="LabelBox_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Label Target="{Binding ElementName=ArgumentsBox}" Padding="0" Margin="0,0,0,6" FontSize="12"
                           Foreground="{StaticResource MutedBrush}" Content="_Arguments (optional)" />
                    <TextBox x:Name="ArgumentsBox" Style="{StaticResource InputStyle}" />
                </StackPanel>
            </Grid>

            <CheckBox x:Name="AdminBox" Style="{StaticResource CheckBoxStyle}" Margin="0,16,0,0"
                      Content="Always run as administrator" />
        </StackPanel>

        <!-- Footer -->
        <Border Height="60" Padding="20,0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button x:Name="OkButton" Content="Add" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="8,0,0,0" Click="Ok_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
