<UserControl x:Class="ExPlane.Modules.Launcher.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Bottom">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Style="{StaticResource IconButtonStyle}" Width="Auto" Height="30"
                    HorizontalAlignment="Stretch" Click="AddGroup_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE710;"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Group" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="Auto" Height="30"
                    HorizontalAlignment="Stretch" Click="AddPortal_Click"
                    ToolTip="A group that shows a folder's contents live">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" FontSize="11" Text="&#xE8B7;"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Folder portal" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="Transparent" AllowDrop="True"
                                DragOver="Group_DragOver" Drop="Group_Drop">
                            <StackPanel>
                                <!-- Header: click to roll up / expand, right-click for group actions. -->
                                <Grid Height="26" Background="{StaticResource SurfaceBrush}" Cursor="Hand"
                                      MouseLeftButtonUp="GroupHeader_MouseLeftButtonUp">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Add item…" Click="AddItem_Click" IsEnabled="{Binding CanEditItems}" />
                                            <MenuItem Header="Open folder" Click="OpenPortalFolder_Click" IsEnabled="{Binding IsPortal}" />
                                            <Separator />
                                            <MenuItem Header="Move group up" Click="MoveGroupUp_Click" />
                                            <MenuItem Header="Move group down" Click="MoveGroupDown_Click" />
                                            <Separator />
                                            <MenuItem Header="Delete group" Click="DeleteGroup_Click" />
                                        </ContextMenu>
                                    </Grid.ContextMenu>

                                    <TextBlock x:Name="Chevron" FontFamily="{StaticResource IconFont}" FontSize="9"
                                               Text="&#xE70D;" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="10,0,6,0" />
                                    <TextBlock x:Name="PortalGlyph" Grid.Column="1" FontFamily="{StaticResource IconFont}"
                                               FontSize="12" Text="&#xE8B7;" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed" />
                                    <TextBox Grid.Column="2" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                             Style="{StaticResource InlineEditStyle}" HorizontalAlignment="Left"
                                             VerticalAlignment="Center" MinWidth="20" Cursor="IBeam"
                                             ToolTip="Click to rename" KeyDown="GroupName_KeyDown" />
                                    <TextBlock x:Name="Count" Grid.Column="3" Text="{Binding CountText}"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               VerticalAlignment="Center" Margin="6,0,10,0" Visibility="Collapsed" />
                                </Grid>

                                <Grid x:Name="Body">
                                    <TextBlock x:Name="EmptyHint" Text="{Binding EmptyHint}" Visibility="Collapsed"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,10" />
                                    <ItemsControl ItemsSource="{Binding Items}" Margin="4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border x:Name="Tile" Width="70" Padding="2,6" CornerRadius="3"
                                                        Background="Transparent" Cursor="Hand"
                                                        ToolTip="{Binding ToolTipText}"
                                                        PreviewMouseLeftButtonDown="Item_PreviewMouseLeftButtonDown"
                                                        MouseMove="Item_MouseMove"
                                                        MouseLeftButtonUp="Item_MouseLeftButtonUp">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="Open" FontWeight="Bold" Click="OpenItem_Click" />
                                                            <MenuItem Header="Run as administrator" Click="RunAsAdmin_Click" />
                                                            <MenuItem Header="Open file location" Click="OpenLocation_Click" IsEnabled="{Binding IsPath, Mode=OneWay}" />
                                                            <Separator />
                                                            <MenuItem Header="Edit…" Click="EditItem_Click" IsEnabled="{Binding CanEdit, Mode=OneWay}" />
                                                            <MenuItem Header="Remove" Click="RemoveItem_Click" IsEnabled="{Binding CanEdit, Mode=OneWay}" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <StackPanel>
                                                        <Image Source="{Binding Icon}" Width="32" Height="32"
                                                               RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,4,0,0"
                                                                   TextAlignment="Center" TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis" MaxHeight="30" />
                                                    </StackPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Tile" Property="Background" Value="{StaticResource HoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                        <Setter TargetName="Tile" Property="Opacity" Value="0.4" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Chevron" Property="Text" Value="&#xE76C;" />
                                <Setter TargetName="Count" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsPortal}" Value="True">
                                <Setter TargetName="PortalGlyph" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter TargetName="EmptyHint" Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
