<Window x:Class="ExPlane.Controls.PromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ExPlane.Controls"
        Width="360" SizeToContent="Height"
        Style="{StaticResource DialogWindowStyle}" WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=InputBox}">
    <StackPanel>
        <controls:DialogTitleBar x:Name="TitleBar" />

        <StackPanel Margin="20,18">
            <Label x:Name="PromptLabel" Target="{Binding ElementName=InputBox}" Padding="0" Margin="0,0,0,6"
                   FontSize="12" Foreground="{StaticResource MutedBrush}" />
            <TextBox x:Name="InputBox" Style="{StaticResource InputStyle}" />
        </StackPanel>

        <Border Height="60" Padding="20,0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource SecondaryButtonStyle}" />
                <Button Content="Save" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"
                        Click="Save_Click" />
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
