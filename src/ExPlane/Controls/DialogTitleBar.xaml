<UserControl x:Class="ExPlane.Controls.DialogTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Grid Height="40" Background="{StaticResource SurfaceBrush}">
        <Border VerticalAlignment="Bottom" Height="1" Background="{StaticResource BorderBrush}" />
        <TextBlock Text="{Binding Text, ElementName=Root}" Margin="16,0" VerticalAlignment="Center"
                   FontWeight="SemiBold" />
        <Button Style="{StaticResource TitleButtonStyle}" HorizontalAlignment="Right" Content="&#xE8BB;" FontSize="10"
                ToolTip="Close" WindowChrome.IsHitTestVisibleInChrome="True" Click="Close_Click" />
    </Grid>
</UserControl>
